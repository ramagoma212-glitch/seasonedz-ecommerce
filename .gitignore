# Dependencies
node_modules

# Build output
dist
dist-ssr
dist-analytics-test
dist-chatbot-test
*.local

# Playwright smoke-test output (Version 7, Milestone 103)
test-results/
playwright-report/
blob-report/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables — ignore every real .env* file (.env,
# .env.local, .env.production, .env.production.local, etc.), but keep
# .env.example / .env.*.example tracked (they're documentation, never
# real secrets).
.env*
!.env.example
!.env.*.example

# Production database backups (pg_dump output) — contains real
# customer/order data, must never be committed. See the milestone
# deployment procedures that create these under backups/.
backups/

# Disposable local Postgres data directory (embedded-postgres package),
# used only for safe local migration generation/verification — never
# committed, never touches production.
.embedded-pg-data/
backend/.embedded-pg-data/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?
