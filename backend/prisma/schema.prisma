// Seasonedz Group backend — Prisma schema (Version 2).
//
// Schema designed in Milestone 10; migrated against a real Postgres
// (Supabase) database and seeded with starter data in Milestone 11.
// See backend/DATABASE_SCHEMA_PLAN.md for the full design rationale
// (why order data is "snapshotted", how guest checkout maps onto
// Customer/Order, how future PayFast/courier/auth plug in, etc).
//
// Nothing here is wired up to the API yet — no routes, no controllers,
// no frontend connection. That's later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

// Version 7, Milestone 152: secure digital downloads. Deliberately just
// two values — the milestone brief allows a MIXED product type "only if
// needed"; a single product is always either a physical item shipped by
// courier or a digital file unlocked after payment, never both at once
// (a bundle of one physical + one digital product is just two separate
// PHYSICAL/DIGITAL OrderItems on the same order — see OrderItem's own
// productType snapshot below), so no third value is needed.
enum ProductType {
  PHYSICAL
  DIGITAL
}

// Version 7, Milestone 168C: replaces the old single universal delivery
// fee with three owner-approved fulfilment methods. COURIER_LOCKER and
// COURIER_DOOR both use the existing delivery* address fields (real
// per-locker selection isn't integrated yet, so Locker orders currently
// reuse the same address collection as Door to Door); COLLECTION uses
// collectionCity instead and needs no delivery address at all.
enum DeliveryMethod {
  COURIER_LOCKER
  COURIER_DOOR
  COLLECTION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYFAST
  CASH_ON_DELIVERY
  MANUAL
}

enum FulfilmentStatus {
  NOT_STARTED
  PACKING
  READY
  SHIPPED
  DELIVERED
  RETURNED
}

enum EnquiryType {
  CONTACT
  SCHOOL
  WHOLESALE
  DISTRIBUTOR
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

// Version 7, Milestone 168F: newsletter subscription only ever moves
// between these two states — a subscriber unsubscribes and can
// voluntarily re-subscribe later, but there's no "pending"/"bounced"
// state yet since no real email-sending system exists in this project
// (see NewsletterSubscriber's own comment).
enum NewsletterSubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum CustomerType {
  GUEST
  REGISTERED
  SCHOOL
  WHOLESALE
  DISTRIBUTOR
}

enum UserRole {
  ADMIN
  STAFF
}

// Version 7, Milestone 171F: social sign-in providers. Only identity
// authentication is supported for each — see AuthAccount below.
enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

// Version 7, Milestone 62: distinguishes who/what produced an
// OrderStatusHistory row. Only ADMIN_DASHBOARD is ever written by the
// first implementation (a future milestone) — the others are reserved
// for later, not yet wired up to anything. See
// VERSION_7_ORDER_STATUS_AUDIT_MODEL_PLAN.md Section 5.
enum OrderStatusHistorySource {
  ADMIN_DASHBOARD
  SYSTEM
  PAYFAST_ITN
  MANUAL_DATABASE_LEGACY
}

// ============================================================================
// CATALOGUE: Category, Product, ProductImage, ProductTag
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  sku               String?       @unique
  description       String?
  shortDescription  String?
  price             Decimal       @db.Decimal(10, 2)
  oldPrice          Decimal?      @db.Decimal(10, 2)
  // Internal cost, never exposed to the storefront — used for margin
  // reporting once an admin dashboard exists.
  costPrice         Decimal?      @db.Decimal(10, 2)
  stockQuantity     Int           @default(0)
  lowStockThreshold Int           @default(5)
  status            ProductStatus @default(DRAFT)
  ageRange          String?
  // Flexible bag for feature bullet points etc. — deliberately loose
  // (Json, not a separate table) since the exact shape may evolve.
  features          Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images     ProductImage[]
  tags       ProductTag[]
  // Historical line items reference a product for convenience, but
  // never depend on it still existing — see OrderItem below.
  orderItems OrderItem[]
  // Version 7, Milestone 171C: this is the "future Review model" the
  // comment below already anticipated — see ProductReview.
  reviews    ProductReview[]

  // Aggregate fields, recalculated whenever a future Review model is
  // added and reviews are created/removed — not maintained by hand.
  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  reviewCount   Int     @default(0)

  isFeatured    Boolean @default(false)
  isBestSeller  Boolean @default(false)
  isNewArrival  Boolean @default(false)
  discountLabel String?

  // Version 7, Milestone 152: secure digital downloads. `productType`
  // defaults PHYSICAL so every existing product (and every place that
  // creates a Product without knowing about this milestone) keeps its
  // exact current behaviour — stock/Courier Guy/delivery-address rules
  // all still apply to it unchanged. `digitalAsset` is optional and
  // one-to-one: a digital product has at most one attached file at a
  // time (replacing it updates the same row rather than adding a
  // second) — see DigitalAsset below. `downloadEnabled` is a separate
  // switch from `status` so an owner can pause access to a paid file
  // (e.g. while fixing a printing error) without un-publishing the
  // whole product listing.
  productType      ProductType   @default(PHYSICAL)
  digitalTermsNote String?
  downloadEnabled  Boolean       @default(true)
  digitalAsset     DigitalAsset?

  // Version 7, Milestone 174C: customer engagement — see each model's
  // own header comment.
  stockAlertSubscriptions StockAlertSubscription[]
  wishlistItems           WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([productType])
}

// Version 7, Milestone 152: the one digital file attached to a DIGITAL
// product. A private-bucket object, never a public URL — storageBucket/
// storagePath are internal identifiers only, resolved into a short-lived
// signed URL at download time (services/digitalAssetStorage.service.ts)
// and never returned directly to any frontend response (see
// services/digitalDownload.service.ts). `productId` unique enforces
// "at most one file per product" — admin.service.ts's replace flow
// updates this same row (new storagePath, old object best-effort
// deleted afterward) rather than creating a second DigitalAsset.
model DigitalAsset {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  fileName      String
  displayName   String
  storageBucket String
  storagePath   String
  mimeType      String
  fileSizeBytes Int
  pageCount     Int?
  version       String?
  isActive      Boolean @default(true)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductTag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

// ============================================================================
// CUSTOMERS & ADDRESSES
// ============================================================================

// Represents both guest and registered customers — `type` distinguishes
// them. Version 7, Milestone 127 adds real login (`type: REGISTERED`,
// `passwordHash` set) on top of this same model rather than a separate
// table — see CustomerSession below and backend/src/services/
// customerAuth.service.ts. `passwordHash` is null for a guest-only row;
// no guest-checkout code path creates a Customer row at all today (see
// order.service.ts), so `email` unique is safe to add here — every
// Customer row that will ever exist from this point on is created only
// by registration, one per email.
model Customer {
  id        String       @id @default(cuid())
  type      CustomerType @default(GUEST)
  firstName String
  lastName  String
  email     String       @unique
  phone     String?

  // Version 7, Milestone 127: null for a guest-only row. Never returned
  // or logged by anything — see customerAuth.service.ts's toSafeProfile().
  passwordHash           String?
  isActive               Boolean   @default(true)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  // SHA-256 hash of a password-reset token, same "never store the raw
  // secret" discipline as CustomerSession.tokenHash below — the raw
  // token only ever exists in a reset-link email. Unused until a future
  // milestone builds password reset; present now so that milestone is
  // additive, not another schema change.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  // Version 7, Milestone 171F: optional avatar sourced from a connected
  // social provider (Google/Facebook may supply one; Apple never does).
  // Never required, never fetched/stored proactively — only populated
  // the moment a real provider profile is read during sign-in/linking.
  // See socialAuth.service.ts.
  profileImageUrl String?

  orders                  Order[]
  addresses               Address[]
  sessions                CustomerSession[]
  // Version 7, Milestone 152: best-effort admin-view linkage only — see
  // DigitalDownloadLog's own comment for why real entitlement checks
  // never rely on this relation.
  digitalDownloadLogs     DigitalDownloadLog[]
  // Version 7, Milestone 171C: genuine, verified-purchase product
  // reviews this customer has submitted — see ProductReview.
  productReviews          ProductReview[]
  // Version 7, Milestone 171F: connected social sign-in identities —
  // see AuthAccount below. A customer may have zero (password-only),
  // one, or several (one per provider, never two of the same provider).
  authAccounts            AuthAccount[]
  // Version 7, Milestone 172B.3: optional link to Seasonedz's own
  // affiliate/referral programme — see Affiliate's own comment. Zero
  // or one, never more (Affiliate.customerId is @unique): one Customer
  // can never be linked to two affiliate records.
  affiliate               Affiliate?
  // Version 7, Milestone 174C: customer engagement — see each model's
  // own header comment.
  stockAlertSubscriptions StockAlertSubscription[]
  wishlistItems           WishlistItem[]
  checkoutIntents         CheckoutIntent[]
  notificationPreference  NotificationPreference?
  // Version 7, Milestone 176: at most one in-progress/completed
  // affiliate application per customer — see AffiliateApplication's own
  // header comment.
  affiliateApplication    AffiliateApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Version 7, Milestone 171F: one row per (customer, provider) social
// identity — see AUTH_ACCOUNT_MODEL in the milestone brief. Deliberately
// NOT a GoogleCustomer/FacebookCustomer/AppleCustomer table per provider
// — one customer, one stable internal id, N linked AuthAccount rows.
//
// providerUserId is always the provider's own immutable subject
// identifier (Google/Apple: "sub"; Facebook: the numeric user id) —
// never an email address, since a provider account's email can change
// (or, for Apple, be a rotating private-relay address) while its
// subject identifier never does. See socialAuth.service.ts for how
// this is looked up first, before ever falling back to email matching.
//
// No password, no provider access/refresh token is ever stored here —
// this table exists purely to answer "which Seasonedz customer does
// this verified provider identity belong to", nothing more.
model AuthAccount {
  id             String       @id @default(cuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // A provider identity must never belong to more than one customer —
  // this is the structural guarantee against account-takeover-by-OAuth,
  // enforced at the database level, not just in application code.
  @@unique([provider, providerUserId])
  @@index([customerId])
}

// Saved addresses for a customer (useful once accounts exist so a
// returning customer can pick a saved address at checkout). This is
// separate from the delivery details actually stored on each Order —
// see the note on Order below for why those are never a foreign key
// to this table.
model Address {
  id            String    @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  streetAddress String
  suburb        String
  city          String
  province      String
  postalCode    String
  country       String    @default("South Africa")
  deliveryNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// Version 7, Milestone 127: server-side customer session storage —
// deliberately the same tokenHash/HttpOnly-cookie pattern as
// AdminSession above, but a fully separate table. A customer session
// must never authenticate an admin route, and an admin session must
// never authenticate a customer route; keeping these as two distinct
// models (rather than one shared "Session" table with a role column)
// makes that separation structural, not just a runtime check that
// could be gotten wrong later. tokenHash is a SHA-256 hash of the raw
// session token — the raw token is only ever sent to the browser as an
// HttpOnly cookie (name: customer_session) and is never persisted.
model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

// ============================================================================
// ORDERS
// ============================================================================

// Supports guest checkout (customerId is null) and future registered
// checkout (customerId set) equally.
//
// IMPORTANT: customer name/contact details and the full delivery
// address are stored directly on the order (not just via a relation),
// and OrderItem stores a snapshot of the product's name/slug/price —
// see DATABASE_SCHEMA_PLAN.md for the full rationale. In short: if a
// customer edits their saved address, or a product's name/price
// changes, or a product is deleted entirely, past orders must still
// read back exactly as they were at the time of purchase.
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerEmail     String
  customerPhone     String
  customerFirstName String
  customerLastName  String

  // Version 7, Milestone 168C: these were required (String) when every
  // order was courier-delivered. Customer Collection orders carry no
  // physical delivery address at all (see collectionCity below instead),
  // so these became optional — validated as required at the application
  // layer (order.validator.ts) only for COURIER_LOCKER/COURIER_DOOR,
  // rather than forced at the DB level regardless of delivery method.
  deliveryStreetAddress String?
  deliverySuburb        String?
  deliveryCity          String?
  deliveryProvince      String?
  deliveryPostalCode    String?
  deliveryCountry       String  @default("South Africa")
  deliveryNotes         String?

  // Version 7, Milestone 168C: which of the three owner-approved
  // fulfilment methods the customer chose. Defaults to COURIER_DOOR only
  // to give existing pre-168C rows a valid backfilled value — every new
  // order always sets this explicitly from validated request input.
  deliveryMethod DeliveryMethod @default(COURIER_DOOR)
  // Only populated when deliveryMethod = COLLECTION ("Pretoria" or
  // "Thohoyandou"); null for courier-delivered orders.
  collectionCity String?

  status           OrderStatus      @default(PENDING)
  paymentStatus    PaymentStatus    @default(PENDING)
  fulfilmentStatus FulfilmentStatus @default(NOT_STARTED)
  paymentMethod    PaymentMethod

  subtotal      Decimal @db.Decimal(10, 2)
  // Version 7, Milestone 159: sum of every wrapped OrderItem's own
  // giftWrapFeePerUnit * quantity — see OrderItem below. Kept as its
  // own column (same pattern as deliveryFee/discountTotal) rather than
  // folded into subtotal, so the order summary/checkout/admin views can
  // show "Gift wrapping: R30" as its own line without re-deriving it
  // from every item on every read.
  giftWrapTotal Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  // Internal/admin notes — not shown to the customer.
  notes String?

  items               OrderItem[]
  payment             Payment?
  shipping            Shipping?
  // Version 7, Milestone 62: audit trail for future admin status
  // updates — see OrderStatusHistory below. Empty for every order that
  // predates this feature; that is expected, not backfilled.
  statusHistory       OrderStatusHistory[]
  // Version 7, Milestone 152: guest secure digital-download tokens —
  // see GuestDownloadToken below. Empty for every order with no digital
  // items and for every order placed by a logged-in customer (who
  // downloads via their account instead, never a token).
  guestDownloadTokens GuestDownloadToken[]
  // Version 7, Milestone 172B.3: Seasonedz's own affiliate/referral
  // programme (distinct from the dormant, external-merchant
  // AffiliateProduct/AffiliateClick/AffiliateCommission models above —
  // see OrderAffiliateCommission's own header comment). Optional and
  // one-to-one: most orders are never referred at all, and no code in
  // this milestone ever creates one automatically yet — that's
  // Milestone 172B.4.
  affiliateCommission OrderAffiliateCommission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

// A snapshot of one product at the moment it was ordered — see the
// note on Order above. productId is optional and nullable-on-delete
// in spirit (a product can be removed from the catalogue later
// without breaking historical orders), while productName/productSlug/
// unitPrice/lineTotal always remain, sourced from the order itself
// rather than a live join to Product.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  productName String
  productSlug String
  sku         String?

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  // Version 7, Milestone 152: snapshotted at order-creation time, same
  // "never depend on the live Product row" philosophy as
  // productName/productSlug/unitPrice above — a product's type can't
  // realistically change after being sold, but this guarantees
  // Courier Guy gating and download-access checks for an existing order
  // are never affected even if it did. digitalAssetId is nullable and
  // SetNull-on-delete: it's only ever set for a DIGITAL line item, and
  // deleting a DigitalAsset (e.g. an admin removing a retired file) must
  // never cascade-delete the historical order line that references it.
  productType    ProductType   @default(PHYSICAL)
  digitalAssetId String?
  digitalAsset   DigitalAsset? @relation(fields: [digitalAssetId], references: [id], onDelete: SetNull)

  // Version 7, Milestone 159: optional paid gift wrapping, PHYSICAL
  // items only (enforced server-side in order.service.ts's
  // verifyItems() — never trusted from the client). A wrapped line
  // means every unit on it is wrapped (quantity above IS the wrapped
  // quantity for this line; there is no separate "wrapped count" field
  // by design — see this milestone's own report for why splitting
  // wrapped/unwrapped units of the same product means two separate
  // OrderItem rows instead). giftWrapFeePerUnit is snapshotted at
  // order-creation time, same "never depend on a live, changeable
  // value" philosophy as unitPrice/productType above — if the R30 rate
  // ever changes later, a historical order still shows what was
  // actually charged. Null (not 0) when isGiftWrapped is false, so
  // "never wrapped" and "wrapped for free" are never ambiguous.
  isGiftWrapped      Boolean  @default(false)
  giftMessage        String?
  giftWrapFeePerUnit Decimal? @db.Decimal(10, 2)

  downloadLog    DigitalDownloadLog?
  // Version 7, Milestone 171C: genuine product reviews — see
  // ProductReview below. One OrderItem can have at most one review
  // (reviewsForItem @@unique enforces this), but a review only ever
  // exists here if a customer actually chose to write one; nothing
  // about placing/paying for an order creates a review automatically.
  reviewsForItem ProductReview[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([digitalAssetId])
}

// Version 7, Milestone 152: tracks download activity for one purchased
// digital line item — one row per OrderItem (orderItemId unique), not
// per customer or per asset in general, so "has this specific purchase
// been downloaded, and how many times" is a single direct lookup.
// customerId is nullable (SetNull on delete) purely for a friendlier
// admin view later; every real entitlement check re-verifies ownership
// against the OrderItem's own Order.customerId or a GuestDownloadToken,
// never against this row.
model DigitalDownloadLog {
  id             String    @id @default(cuid())
  orderItemId    String    @unique
  orderItem      OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  digitalAssetId String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([digitalAssetId])
  @@index([customerId])
}

// Version 7, Milestone 152: secure guest access to digital downloads —
// a paid guest order's owner never has an account to log into, so a
// random, hashed, expiring token (emailed as a download link once
// payment is confirmed — see courierGuy/payfast.service.ts's own
// comments and services/digitalDownload.service.ts) is the only way a
// guest can ever reach GET/POST /api/downloads/guest/:token. Same
// "never store the raw secret" discipline as CustomerSession.tokenHash/
// AdminSession.tokenHash: the raw token exists only in the one email
// link it's sent in, and is hashed (SHA-256) before being written here.
model GuestDownloadToken {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([orderId])
  @@index([expiresAt])
}

// ============================================================================
// PAYMENT & SHIPPING
// ============================================================================

// One payment record per order. Ready for a future PayFast
// integration (provider/providerReference/paidAt/failureReason) but
// nothing here calls PayFast or any other provider yet — this is
// storage shape only.
model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  provider          String?
  providerReference String?
  paidAt            DateTime?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One shipping record per order. Ready for a future courier
// integration (courierName/trackingNumber/trackingUrl) but nothing
// here calls a courier API yet — this is storage shape only, and
// `status` is set manually until that integration exists.
model Shipping {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status            FulfilmentStatus @default(NOT_STARTED)
  courierName       String?
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  // Version 7, Milestone 112: admin-only Courier Guy booking. All
  // nullable — every existing row (and any order created before
  // booking exists) simply has these unset, exactly like every other
  // optional field above. Only ever written by
  // courierGuy.service.ts's bookCourierShipment(), inside the same
  // transaction as everything else in this model — see that file's
  // own header comment for the full safety discipline (no booking
  // without COURIER_GUY_BOOKING_ENABLED, no duplicate booking, no
  // automatic booking).
  courierProvider    String?
  courierShipmentId  String?
  courierServiceCode String?
  courierServiceName String?
  courierCost        Decimal?  @db.Decimal(10, 2)
  courierBookedAt    DateTime?

  // Version 7, Milestone 139: automatic-booking failure visibility.
  // Both nullable, additive — every existing row simply has these
  // unset. Only ever written by courierGuy.service.ts's
  // autoBookCourierForPaidOrder() when a real booking attempt fails,
  // so an admin can tell "attempted and failed" apart from "never
  // attempted" (both otherwise look identical: every courier* field
  // above still null either way). courierBookingError is always a
  // short, safe internal message — never the raw Courier Guy response
  // body, an API key, or any other secret.
  courierBookingAttemptedAt DateTime?
  courierBookingError       String?

  // Version 7, Milestone 173: automatic courier delivery status sync.
  // Both nullable, additive. lastCourierStatus is the raw, unmapped
  // status string exactly as received from the courier webhook (e.g.
  // "in-transit", "undeliverable") — kept for admin visibility and as
  // the idempotency/out-of-order-protection comparison key (see
  // courierStatusSync.service.ts's STATUS_RANK table), never itself
  // shown to customers. lastCourierStatusAt is when this backend last
  // processed a genuine courier status event for this shipment — used
  // as the admin-facing "last status update" time, distinct from
  // deliveredAt (which is only ever set once the mapped stage reaches
  // DELIVERED).
  lastCourierStatus   String?
  lastCourierStatusAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PRODUCT REVIEWS
// ============================================================================

// Version 7, Milestone 171C: a review only ever exists here because a
// real, logged-in customer submitted it — there is no admin "create
// review" path anywhere in this codebase (see
// adminProductReview.service.ts). Starts PENDING; only becomes public
// once an admin explicitly approves it.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Genuine, verified-purchase product reviews. Eligibility (Part E of
// the milestone brief) is enforced entirely server-side, at write
// time, in productReview.service.ts — never trusted from the frontend:
// the submitting customer must be authenticated, and orderItemId must
// reference a real OrderItem that (a) belongs to that customer's own
// Order, (b) is for this exact product, and (c) belongs to an Order
// whose paymentStatus is PAID. None of that is re-validated by the
// database itself (Prisma has no cross-table CHECK constraints), which
// is exactly why the service layer re-derives and re-checks it on
// every single submission rather than ever trusting a previously
// "verified" flag.
model ProductReview {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // The specific purchase this review is based on — one of possibly
  // several qualifying OrderItems for this product/customer pair, kept
  // only as the proof-of-purchase reference (never displayed publicly,
  // never used for eligibility again after submission). Not marked
  // @unique itself: the real anti-duplicate rule is
  // @@unique([productId, customerId]) below, which already guarantees
  // at most one ProductReview will ever cite any given OrderItem in
  // practice (an OrderItem has exactly one product, so a customer who
  // already has a review for that product can never create a second
  // one citing a different item of the same product).
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // 1-5, enforced in the service layer (see MIN_RATING/MAX_RATING in
  // productReview.service.ts) — Prisma/Postgres have no portable CHECK
  // constraint in this schema today, matching this project's existing
  // discipline of app-layer validation for bounded numeric fields.
  rating     Int
  reviewText String

  status     ReviewStatus @default(PENDING)
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One genuine review per product per customer — the simplest,
  // clearest duplication rule (Part F of the milestone brief), and the
  // one enforcement point productReview.service.ts's submitReview()
  // relies on (a duplicate attempt fails this DB constraint inside the
  // same transaction, never a separate racy pre-check).
  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([customerId])
  @@index([status])
}

// ============================================================================
// ENQUIRIES
// ============================================================================

// One model backing all four demo forms on the frontend (Contact,
// Schools, Wholesale, Distributor) — `type` distinguishes which form
// it came from. Replaces those forms' current "doesn't send yet" demo
// message once a real /api/enquiries endpoint exists in a later
// milestone.
model Enquiry {
  id     String        @id @default(cuid())
  type   EnquiryType
  status EnquiryStatus @default(NEW)

  name              String
  email             String
  phone             String?
  companyName       String?
  organisationType  String?
  subject           String?
  message           String
  province          String?
  city              String?
  // Free text on purpose (e.g. "50-100 units", "a few hundred a
  // year") — wholesale/distributor enquiries rarely give a precise
  // number.
  estimatedQuantity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// FUTURE ADMIN
// ============================================================================

// Version 7, Milestone 58: passwordHash added — a securely hashed
// credential (bcrypt, via bcryptjs), never plain text. No row in this
// table is created or seeded by any code in this repository; the only
// way to create one is the manual bootstrap script
// (prisma/scripts/setupAdminUser.ts), which must be run deliberately
// with real values supplied as environment variables at invocation
// time, never hardcoded and never run automatically.
model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  sessions                          AdminSession[]
  // Version 7, Milestone 62: SetNull (not Cascade) — deleting an admin
  // user must never delete the audit history of what they did. See
  // OrderStatusHistory below and
  // VERSION_7_ORDER_STATUS_AUDIT_MODEL_PLAN.md Section 4.
  orderStatusHistory                OrderStatusHistory[]
  // Version 7, Milestone 172B.3: audit trail for who last changed the
  // affiliate programme's rates — see AffiliateProgrammeSettings' own
  // comment. In practice at most one row ever references a given
  // admin at a time (the settings table is a singleton), but the
  // relation is still an array from this side since Prisma requires
  // the reverse of a to-one relation to be declared as one.
  affiliateProgrammeSettingsUpdates AffiliateProgrammeSettings[]
  // Version 7, Milestone 176: audit trail entries this admin generated
  // reviewing an affiliate application — SetNull (not Cascade), same
  // "deleting an admin must never delete the audit history of what they
  // did" discipline as orderStatusHistory above.
  affiliateApplicationEvents        AffiliateApplicationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Version 7, Milestone 58: server-side admin session storage.
// tokenHash is a SHA-256 hash of the random session token — the raw
// token itself is only ever sent to the browser as an HttpOnly cookie
// and is never persisted anywhere, matching the same "never store the
// raw secret" discipline already used for PayFast/email credentials
// in this project. A session is looked up by hashing whatever token
// arrives in the request cookie and comparing against tokenHash — the
// same principle as a hashed password, applied to a session token.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// Version 7, Milestone 62: audit trail for order status changes.
// Schema and migration only — no row is written by any code yet; the
// future order-status-update feature (Milestone 63) is what will
// actually create rows here, and only ever with source
// ADMIN_DASHBOARD. See VERSION_7_ORDER_STATUS_AUDIT_MODEL_PLAN.md for
// the full design rationale.
//
// orderNumberSnapshot + changedByAdminEmailSnapshot/NameSnapshot exist
// so a history row stays fully readable even if the order's own
// number were ever to change (it can't today, but never assume) or —
// more importantly — if the admin who made the change is later
// deleted. changedByAdminUserId is optional with onDelete: SetNull for
// exactly that reason: deleting an AdminUser must never delete the
// record of what they did.
//
// No old order is backfilled with fake history — every order that
// existed before this model was added simply has no rows here, which
// the future admin UI must display honestly ("No status history
// recorded yet."), never invented.
model OrderStatusHistory {
  id                  String @id @default(cuid())
  orderId             String
  order               Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumberSnapshot String

  changedByAdminUserId        String?
  changedByAdminUser          AdminUser? @relation(fields: [changedByAdminUserId], references: [id], onDelete: SetNull)
  changedByAdminEmailSnapshot String?
  changedByAdminNameSnapshot  String?

  oldStatus OrderStatus
  newStatus OrderStatus

  note   String?
  source OrderStatusHistorySource

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([orderNumberSnapshot])
  @@index([changedByAdminUserId])
  @@index([source])
  @@index([createdAt])
}

// Version 7, Milestone 168F: real storage for the homepage "Free Pages
// and Fresh Updates" newsletter form (components/newsletterSignup.js)
// — replaces that form's previous permanent "not available yet"
// message. Deliberately minimal: no marketing-automation fields, no
// campaign/send history, nothing beyond what's needed to record a
// genuine, voluntary opt-in and let someone unsubscribe/re-subscribe
// later. `email` is unique (case-insensitively normalised by the
// service layer before every write/lookup) so the same person can
// never end up with two rows. `consentAt` + `source` exist specifically
// as POPIA proof-of-consent — recorded fresh on every voluntary
// (re-)subscription, never backfilled or inferred from a purchase.
model NewsletterSubscriber {
  id     String                     @id @default(cuid())
  name   String
  email  String                     @unique
  status NewsletterSubscriberStatus @default(ACTIVE)

  // Always "WEBSITE" today (the only real entry point) — kept as a
  // field rather than a hardcoded assumption so a future genuinely
  // different entry point (e.g. an in-store signup sheet) doesn't need
  // a schema change, only a new value.
  source         String    @default("WEBSITE")
  consentAt      DateTime
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// AFFILIATE RECOMMENDATIONS
// ============================================================================

// Version 7, Milestone 172B: schema foundation for the affiliate
// recommendation system (see the 172A architecture audit for the full
// reasoning). Deliberately unrelated to Product/Category — an
// AffiliateProduct is never sold, shipped or fulfilled by Seasonedz,
// so it carries no foreign key into either table. This is what makes
// direct-store separation structural rather than a rule someone has
// to remember: nothing in cart/checkout/Order/the Merchant feed ever
// looks up an AffiliateProduct, because none of those code paths know
// this table exists.
//
// No public route reads or writes any of these three models yet —
// the public /go/:trackingSlug redirect and GET /api/affiliate/products
// are Milestone 172C. This migration exists now so 172C's own change
// can be additive too, the same "schema first, feature after"
// discipline already used for DigitalAsset (Milestone 152) and
// ProductReview (Milestone 171C) before their own features shipped.
model AffiliateProduct {
  id           String  @id @default(cuid())
  title        String
  author       String?
  slug         String  @unique
  // The public identifier used only by the future /go/:trackingSlug
  // redirect (172C) — kept distinct from slug so a cosmetic slug edit
  // never has to also break a link an owner has already shared. See
  // affiliateProduct.validator.ts for the "never silently rewrite an
  // existing trackingSlug" rule.
  trackingSlug String  @unique
  description  String?
  imageUrl     String?
  // Deliberately free text, not a relation to Category — an affiliate
  // recommendation is never a Seasonedz product and must never be
  // able to appear alongside real inventory through a shared category
  // join. See the 172A audit's own Phase 4 finding.
  category     String?

  merchantName     String
  affiliateNetwork String?
  // The actual redirect destination. Never returned by the public API
  // and never supplied by a site visitor — only ever written by an
  // admin, through affiliateProductUrl.validator.ts's HTTPS-only
  // checks.
  affiliateUrl     String

  // Optional and paired with priceLastCheckedAt on purpose — an
  // external merchant's price can move at any time and this database
  // has no way to know when it last did. The future public card
  // (172C) only ever shows a number when priceLastCheckedAt is
  // recent; otherwise it shows "View current price on {merchant}"
  // instead of a figure that might already be wrong. See the 172A
  // audit's own pricing finding.
  price              Decimal?  @db.Decimal(10, 2)
  currency           String    @default("ZAR")
  priceLastCheckedAt DateTime?
  // Owner-entered only, e.g. "Save 20%" — never computed from price.
  discountText       String?
  // Owner-entered only, never fabricated — the same "never invent an
  // identifier" discipline already proven for GTIN (Milestone 171I.1)
  // and product ids (171I.2), applied here to a rating instead.
  rating             Decimal?  @db.Decimal(3, 2)

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  clicks      AffiliateClick[]
  commissions AffiliateCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([merchantName])
}

// Version 7, Milestone 172B: one row per successful future
// /go/:trackingSlug redirect (172C) — created now so that migration
// is unnecessary. Deliberately minimal: see the 172A audit's own
// privacy-minimising design. No public writer exists yet in 172B, so
// this table can only ever be empty in production until 172C ships.
model AffiliateClick {
  id                 String           @id @default(cuid())
  affiliateProductId String
  affiliateProduct   AffiliateProduct @relation(fields: [affiliateProductId], references: [id], onDelete: Cascade)

  clickedAt   DateTime @default(now())
  // Short, validated attribution strings only — never a customer
  // identifier of any kind. See the 172A audit's own Phase 8
  // constraints.
  campaign    String?
  source      String?
  placement   String?
  // Hostname only (e.g. "seasonedzgroup.co.za") — never the full
  // referrer URL or its query string, which can carry personal
  // information from a search or email link. See the 172A audit's own
  // Phase 6 finding.
  refererHost String?

  @@index([affiliateProductId, clickedAt])
  @@index([campaign])
}

// Version 7, Milestone 172B: manual commission records for networks
// with no reporting API — entered one at a time by an admin, never
// derived from AffiliateClick. A click is not a sale; nothing in this
// codebase is ever allowed to infer commissionEarned from a click
// count. affiliateProductId is optional with onDelete: SetNull, and
// productTitleSnapshot always remains — the same "financial history
// must survive the row it points to being removed" discipline already
// used for OrderStatusHistory.changedByAdminUserId above.
model AffiliateCommission {
  id                   String            @id @default(cuid())
  affiliateProductId   String?
  affiliateProduct     AffiliateProduct? @relation(fields: [affiliateProductId], references: [id], onDelete: SetNull)
  productTitleSnapshot String

  affiliateNetwork  String?
  externalReference String?
  saleDate          DateTime
  saleAmount        Decimal  @db.Decimal(10, 2)
  commissionRate    Decimal? @db.Decimal(5, 2)
  commissionEarned  Decimal  @db.Decimal(10, 2)
  currency          String   @default("ZAR")

  status CommissionStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateProductId])
  @@index([status])
  @@index([saleDate])
}

// Version 7, Milestone 172B: matches this schema's own existing
// status-enum vocabulary — ReviewStatus above already uses PENDING/
// APPROVED/REJECTED. PAID is the one addition, reading the same way
// PaymentStatus.PAID already does elsewhere in this file.
enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// ============================================================================
// SEASONEDZ'S OWN AFFILIATE / REFERRAL PROGRAMME
// ============================================================================

// Version 7, Milestone 172B.3: Seasonedz's own affiliate/referral
// programme — affiliates promote Seasonedz's genuine Product catalogue
// and earn commission on real Orders. This is a completely different
// business from the AffiliateProduct/AffiliateClick/AffiliateCommission
// models above (external merchant recommendations, e.g. Amazon links) —
// see the 172B.2 architecture audit for why those stay untouched and
// dormant rather than being renamed or reused here. Model names below
// are deliberately distinct (Affiliate, not AffiliateProduct;
// OrderAffiliateCommission, not AffiliateCommission) so the two systems
// can never be confused in code or in the database.
//
// Nothing in this migration wires a referral into checkout, discount
// calculation, or commission creation — see AffiliateProgrammeSettings
// and OrderAffiliateCommission's own comments. That's Milestone 172B.4
// (discount/attribution) and 172B.5 (lifecycle).
model Affiliate {
  id String @id @default(cuid())

  // Optional and unique — an affiliate MAY have a Customer account
  // (needed for a future affiliate portal, see the 172B.2 audit), but
  // applying doesn't require one. A future admin action links an
  // existing Customer; nothing here creates one.
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])

  name  String
  // Case-insensitively normalised by the service layer before every
  // write/lookup — same discipline NewsletterSubscriber.email already
  // documents above, applied here so "Person@Example.com" and
  // "person@example.com" can never become two different affiliates.
  email String  @unique
  phone String?

  // Public and shareable — never a secret. Guessing another affiliate's
  // code only misattributes a sale to them, it exposes nothing and
  // grants no access; that's why a short, admin-assignable code is
  // appropriate here rather than a cryptographically random token.
  referralCode String @unique

  status AffiliateStatus @default(PENDING)

  // Null means "use AffiliateProgrammeSettings' current default at the
  // moment of order creation" — never copied in at creation time, so a
  // later programme-wide rate change still applies to every affiliate
  // who has no override of their own. Only a real, deliberately-set
  // override diverges from the shared default.
  commissionRateOverride Decimal? @db.Decimal(5, 2)
  discountRateOverride   Decimal? @db.Decimal(5, 2)

  approvedAt DateTime?
  // Admin-authored context only — never customer-facing.
  notes      String?

  commissions OrderAffiliateCommission[]
  // Version 7, Milestone 176: the richer application/verification
  // record behind this row, when one exists. Optional and one-directional
  // in practice — an Affiliate created the old simple way (before this
  // milestone, or by an admin directly via "Add Affiliate") may have no
  // application at all; see AffiliateApplication's own header comment
  // for how a legacy PENDING affiliate is handled.
  application AffiliateApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No hard-delete workflow anywhere in this codebase for this model —
  // matches the Product/ARCHIVED and AdminUser/isActive precedent.
  // SUSPENDED (not deletion) is how an affiliate stops being eligible
  // while their historical commission records stay fully intact.
  @@index([status])
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

// Version 7, Milestone 172B.3: the one authoritative, admin-editable
// source of truth for the programme's default rates and policy
// numbers. Deliberately a database row, not a config/*.ts constant —
// every other configurable value in this backend (delivery fees, gift
// wrap pricing, feature-enable flags) lives in a TypeScript file and
// needs a redeploy to change; this table exists specifically because
// the owner must be able to change these numbers without one. Exactly
// the seven fields the approved V1 rules name as admin-editable — see
// this milestone's own final report for why several other V1 rules
// (free-delivery threshold basis, repeat-referral-use, self-referral's
// discount-yes/commission-no split) are deliberately fixed service-
// layer policy instead of settings rows here, so there is never a
// second, competing place either kind of rule could live.
//
// Singleton by convention, not a database constraint — Prisma has no
// clean "exactly one row" guarantee. The service layer always reads
// (or creates, on first read, using the values below) the one existing
// row; no route here ever creates a second one — see
// affiliateProgrammeSettings.service.ts's own header comment.
model AffiliateProgrammeSettings {
  id String @id @default(cuid())

  defaultCommissionRate       Decimal @default(7.00) @db.Decimal(5, 2)
  defaultReferralDiscountRate Decimal @default(5.00) @db.Decimal(5, 2)
  // How long a captured referral stays valid before it must be re-
  // captured — see the 172B.2 audit's own "last valid referral wins"
  // attribution design. Not enforced by any code in this milestone;
  // read by whatever captures/resolves attribution in 172B.4.
  attributionWindowDays       Int     @default(30)
  // How long after fulfilment a commission stays PENDING before it may
  // become APPROVED — the actual lifecycle wiring is 172B.5; this is
  // the number that milestone will read.
  commissionValidationDays    Int     @default(30)
  minimumPayoutAmount         Decimal @default(500.00) @db.Decimal(10, 2)
  // Day of the month payouts are targeted for. Monthly cadence itself
  // is implied by this single field existing, not a separate
  // "frequency" field — V1 has exactly one supported frequency, so a
  // frequency enum with one legal value would be complexity with
  // nothing to select between.
  payoutDayOfMonth            Int     @default(15)
  isProgrammeActive           Boolean @default(true)

  // Who last changed these numbers, and when (via updatedAt) — same
  // audit-trail intent as OrderStatusHistory's own admin attribution
  // above, SetNull so deleting an AdminUser can never delete the record
  // of what they changed.
  updatedByAdminUserId String?
  updatedByAdminUser   AdminUser? @relation(fields: [updatedByAdminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Version 7, Milestone 172B.3: one row per Order that was genuinely
// referred — the durable, order-linked record this programme actually
// runs on. Nothing in this milestone creates one: no code path here
// wires this into checkout or order creation yet (that's 172B.4), so
// this table is expected to have zero rows in production until then.
//
// Every financial figure below is captured at the moment the (future)
// referred order is created and never recalculated afterward — a later
// change to AffiliateProgrammeSettings' defaults, an affiliate's own
// override, or even the affiliate's name/code, must never retroactively
// alter a historical commission. affiliateId stays a required (never
// nullable) relation, unlike AffiliateProduct's own nullable
// affiliateProductId on the external AffiliateCommission model — an
// Affiliate is never hard-deleted (see Affiliate's own comment), so
// there is no "the referenced row might vanish" case to guard against
// here. affiliateNameSnapshot/affiliateReferralCodeSnapshot exist
// anyway, for the same "stay readable without a live join" discipline
// OrderItem.productName already established.
model OrderAffiliateCommission {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  affiliateId                   String
  affiliate                     Affiliate @relation(fields: [affiliateId], references: [id])
  affiliateNameSnapshot         String
  affiliateReferralCodeSnapshot String

  // The financial basis, locked in at order-creation time. Base =
  // qualifying product subtotal only — delivery and gift wrapping are
  // never part of it (the approved V1 rule). Commission is calculated
  // on the NET amount, after the referral discount, per the approved
  // worked example (R500 qualifying -> R25 discount -> R475 net -> 7%
  // -> R33.25 commission).
  qualifyingProductSubtotal Decimal @db.Decimal(10, 2)
  discountRateApplied       Decimal @db.Decimal(5, 2)
  discountAmount            Decimal @db.Decimal(10, 2)
  netQualifyingAmount       Decimal @db.Decimal(10, 2)
  commissionRateApplied     Decimal @db.Decimal(5, 2)
  commissionAmount          Decimal @db.Decimal(10, 2)

  status         OrderAffiliateCommissionStatus @default(PENDING)
  // Never set merely because PayFast payment succeeded — the approved
  // V1 policy is fulfilment/delivery plus a commissionValidationDays
  // waiting period. Wiring that transition is 172B.5.
  approvedAt     DateTime?
  paidAt         DateTime?
  // Set on order cancellation or full refund (the approved V1 rule);
  // a partial refund is manual admin review in V1, never automatic.
  reversedAt     DateTime?
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At most one commission per order, enforced at the database level
  // via orderId's own @unique above, not only in application code.
  @@index([affiliateId, status])
  @@index([status])
}

enum OrderAffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

// ============================================================================
// NOTIFICATIONS (Version 7, Milestone 174B)
// ============================================================================

// Version 7, Milestone 174B: a small, stable, real state machine — same
// modelling choice as OrderStatus/PaymentStatus/FulfilmentStatus above,
// unlike eventType/templateName below (see their own comments for why
// those stay plain strings instead).
enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// Version 7, Milestone 174B: only EMAIL is ever actually sent by
// anything today. IN_APP/WHATSAPP are reserved-for-later values (same
// pattern as OrderStatusHistorySource.SYSTEM/PAYFAST_ITN before their
// own milestones wired them up) — adding a Prisma enum value later is
// an additive, safe migration, so this can grow without redesigning
// the column type. notificationEngine.service.ts must never accept
// IN_APP/WHATSAPP as a real send target until a future milestone
// actually implements them — see that file's own header comment.
enum NotificationChannel {
  EMAIL
  IN_APP
  WHATSAPP
}

// Version 7, Milestone 174B: the central outbox for every customer/
// admin notification this backend sends — see
// notificationEngine.service.ts for the one service that reads and
// writes this table. Every existing direct email.service.ts call site
// (order creation, PayFast ITN, enquiry creation, password reset) was
// migrated to enqueue through here instead — see that service's own
// header comment for the full "why."
//
// eventType and templateName are deliberately plain String, not Prisma
// enums, unlike NotificationStatus/NotificationChannel above: this
// catalogue is expected to keep growing across 174C/174D (review
// requests, WhatsApp, back-in-stock, ...), and a Prisma enum would
// require a schema migration for every single new event type — the
// exact friction EmailTemplateName (email.types.ts, a plain TS union,
// never a Prisma enum) already avoids for templates today. Validated
// against a real TypeScript union (NotificationEventType) at the
// application layer instead — see notificationEngine.service.ts.
//
// orderNumber/affiliateId/productId/recipientCustomerId are
// deliberately plain, unenforced reference fields, not real Prisma
// relations — this table only ever needs to display "which order/
// affiliate/product was this about" (an admin-log read), the same
// "snapshot reference, not a live relation" choice
// OrderStatusHistory.orderNumberSnapshot already made for the same
// reason. orderNumber (not an internal id) matches every other call
// site in this codebase, which only ever has the order's public
// orderNumber in hand, never its cuid. Adding four real relations here
// would also mean editing Order/Affiliate/Product/Customer's own
// relation lists for a table that never needs to join back through
// them.
model Notification {
  id String @id @default(cuid())

  eventType    String
  channel      NotificationChannel @default(EMAIL)
  templateName String

  recipientEmail      String?
  recipientCustomerId String?

  orderNumber String?
  affiliateId String?
  productId   String?

  // Deterministic, unique per genuine business event — the sole
  // duplicate-prevention mechanism (brief section 7): a second attempt
  // to enqueue the same event hits this constraint and is treated as
  // "already handled," never a second row. See
  // notificationEngine.service.ts's enqueue() for the exact conflict
  // handling.
  dedupeKey String @unique

  // The exact rendered content, captured once at enqueue time — the
  // caller (which already has the real Order/Affiliate/etc. in hand at
  // the moment of the business event) renders it via the existing
  // emailTemplates.ts functions, exactly as before this milestone. A
  // retry re-sends this same stored content rather than re-deriving
  // possibly-different content later, which also means the processor
  // needs no per-event-type re-fetch logic at all — just "take the
  // stored subject/body, send it." Both stay null for PASSWORD_RESET
  // specifically (see notificationEngine.service.ts's own comment) —
  // the one deliberate exception, so a reset link/token can never end
  // up persisted here.
  renderedSubject String?
  renderedBody    String?

  status NotificationStatus @default(PENDING)

  // When this notification should first be attempted — "now" for every
  // immediate transactional event today; a future 7-day review-request
  // job would set this to deliveredAt + 7 days without needing any
  // schema change (brief section 47). Left untouched by retries — see
  // nextAttemptAt below for that.
  scheduledAt   DateTime  @default(now())
  // Only ever set after a FAILED attempt with retries remaining — null
  // until then. Kept separate from scheduledAt so "when was this
  // originally meant to happen" survives retries unchanged.
  nextAttemptAt DateTime?

  attemptCount Int     @default(0)
  maxAttempts  Int     @default(3)
  // Never a raw provider response body or a secret — brevo.provider.ts
  // already only ever throws a safe BrevoSendError message; nothing
  // here changes that discipline.
  lastError    String?

  sentAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  // Version 7, Milestone 174C: the Customer Notification Centre's own
  // read/unread state (brief section 19). Reuses this same row rather
  // than a separate table — see section 17's own "same Notification
  // row can represent both email and account notification" decision:
  // channel stays a statement of delivery mechanism (how it was sent),
  // never a gate on whether it's visible in the centre. Only rows with
  // a real recipientCustomerId are ever shown there at all (an
  // admin-only or guest row has no "my notifications" to belong to).
  // Null = unread; the exact moment a customer marks it read is stored,
  // never a boolean, so "unread since" is always answerable later.
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The processor's own due-notification query (PENDING, scheduledAt
  // <= now) and its retry query (FAILED, nextAttemptAt <= now) each get
  // their own index rather than one combined index across four columns,
  // since status is always the equality filter and only one of the two
  // date columns is ever range-filtered in the same query.
  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
  @@index([orderNumber])
  @@index([affiliateId])
  // Version 7, Milestone 174C: the notification centre's own primary
  // query — "this customer's own notifications, newest first."
  @@index([recipientCustomerId, createdAt])
}

// ============================================================================
// CUSTOMER ENGAGEMENT (Version 7, Milestone 174C)
// ============================================================================

enum StockAlertStatus {
  PENDING
  NOTIFIED
  CANCELLED
}

// One row per (product, customer) "notify me" request — brief sections
// 23-26. Deliberately logged-in-only (no guest email variant): the
// brief itself says to "prefer logged-in account first if guest
// architecture creates unnecessary privacy complexity," and a guest
// variant would need its own unsubscribe-token/abuse-prevention layer
// for no real V1 benefit. Not @@unique on (productId, customerId) —
// section 24 requires "re-subscribe later works" once a PENDING
// subscription has already been consumed (NOTIFIED), so a customer
// legitimately accumulates more than one row over time for the same
// product; the application layer (not a DB constraint) is what
// prevents a second *PENDING* row for the same pair — see
// stockAlert.service.ts's own header comment.
model StockAlertSubscription {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status     StockAlertStatus @default(PENDING)
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([customerId])
}

// Server-backed wishlist for a logged-in Customer — brief sections
// 26-29. The guest, Local-Storage-only wishlist (src/js/wishlist.js)
// is completely unchanged; this table only ever exists for the
// server-sync layer that activates on login (merge) and lets a
// wishlisted product's own back-in-stock transition reach the
// customer even when their browser/Local Storage isn't the one
// noticing it. Deliberately just `productId` — never a snapshotted
// name/price/image (unlike Order/OrderItem's own historical
// snapshots), since a wishlist always reflects the product's current,
// live state, not a purchase.
model WishlistItem {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One product can only be wishlisted once per customer — the
  // database-enforced anti-duplicate rule the login-merge logic relies
  // on (a duplicate merge attempt is simply absorbed, never a second
  // row), same discipline as ProductReview's own
  // @@unique([productId, customerId]).
  @@unique([customerId, productId])
  @@index([productId])
}

enum CheckoutIntentStatus {
  ACTIVE
  RECOVERED
  REMINDED
  EXPIRED
}

// The minimum safe "who was checking out, and what were they looking
// at" record needed to send ONE abandoned-checkout reminder — brief
// sections 30-36. Never a fake Order: no payment/stock/order-number
// side effect exists anywhere in this table's own lifecycle.
// cartSnapshot deliberately stores only product references/quantities
// (never a price) — section 35's own "never trust saved old prices"
// rule; the recovery flow always re-reads the live Product row at
// recovery time.
//
// recoveryToken is stored in plain, opaque form — deliberately NOT
// hashed, unlike Customer.passwordResetTokenHash/CustomerSession.
// tokenHash/GuestDownloadToken.tokenHash. Those all gate something
// sensitive (account access, a paid digital file) and are always
// consumed at most a short time after being issued, so the raw value
// only ever needs to exist transiently in one email. This token's
// whole purpose is the opposite: it must still be usable when the
// reminder email is actually rendered, up to 2+ hours after capture
// (via the Notification engine's own lazy-render path — see
// productReviewRequest.service.ts's header comment for the identical
// "content produced at send time, not schedule time" pattern) — a
// one-way hash cannot be reversed back into a usable link at that
// point. The blast radius of this token leaking is low and bounded:
// it only ever lets someone pre-fill a cart with product references
// and an email address already visible in this same row — no payment
// detail, no account access, and every price/stock fact is still
// re-verified live at actual checkout regardless (brief section 35).
model CheckoutIntent {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String

  // { items: [{ productId, slug, quantity }], deliveryMethod? } — see
  // checkoutIntent.service.ts's own CheckoutIntentCartSnapshot type for
  // the authoritative shape. Json (not a separate table) since this is
  // a short-lived capture, never queried by its own contents.
  cartSnapshot Json

  recoveryToken String @unique

  status     CheckoutIntentStatus @default(ACTIVE)
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// One row per Customer, created lazily (only once they change
// something away from the default) — brief sections 21-22. Absence of
// a row means every engagement category is still at its default
// (opted in / not opted out); see notificationPreference.service.ts.
// Essential/transactional categories (orders, payments, delivery,
// security, affiliate status, commission/payout) deliberately have NO
// column here at all — there is structurally nothing to opt out of,
// matching brief section 21's "do not allow an opt-out that would
// prevent required operational communication."
model NotificationPreference {
  id String @id @default(cuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  reviewRequestsOptOut    Boolean @default(false)
  stockAlertsOptOut       Boolean @default(false)
  wishlistAlertsOptOut    Boolean @default(false)
  abandonedCheckoutOptOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// AFFILIATE APPLICATION & DOCUMENT VERIFICATION (Version 7, Milestone 176)
// ============================================================================
//
// Upgrades ONLY the affiliate onboarding/verification process — nothing
// here changes Affiliate's own fields, status semantics, or lifecycle
// (approveAffiliate()/rejectAffiliate() in referralAffiliate.service.ts
// are reused completely unchanged). The 7%/5%/30-day/R500/monthly rules
// all live on AffiliateProgrammeSettings/Affiliate exactly as before.
//
// One AffiliateApplication per Customer (customerId @unique) — the
// authoritative record of the richer, document-backed onboarding form.
// It starts DRAFT the moment a customer opens the application page, and
// only ever creates/links a real Affiliate row (via the EXISTING
// createAffiliate()) at genuine submission time — never earlier, so an
// abandoned draft can never itself create a PENDING affiliate the old
// simple "Apply" button used to create immediately. See
// affiliateApplication.service.ts's own header comment for the full
// state machine and for how a customer with a genuine legacy PENDING
// Affiliate row (created by the pre-176 simple Apply flow, with no
// application of its own) is handled — that pre-existing row is linked
// to, never duplicated, and is never force-migrated or auto-activated.
enum AffiliateApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
}

enum AffiliateApplicantType {
  INDIVIDUAL
  BUSINESS
}

enum AffiliateIdentityDocumentType {
  SA_ID
  PASSPORT
}

enum AffiliateProofOfResidenceType {
  BANK_STATEMENT
  MUNICIPAL_ACCOUNT_OR_LETTER
  PROOF_OF_RESIDENCE
}

// Deliberately three outcomes only (brief section 24) — a system that
// cannot reliably classify a document must say so honestly rather than
// force a MATCH/MISMATCH guess. Reused identically for the document-type
// classification itself and for each individual data-matching check
// (name/address/identity-number) — see AffiliateApplicationDocument
// below.
enum AffiliateDocumentMatchResult {
  MATCH
  MISMATCH
  MANUAL_REVIEW
}

enum AffiliateApplicationEventType {
  CREATED
  FIELDS_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_REPLACED
  CLASSIFICATION_COMPLETED
  SUBMITTED
  ACTION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum AffiliateApplicationEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

model AffiliateApplication {
  id String @id @default(cuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Set only once, at genuine submission — see this model's own header
  // comment. onDelete: SetNull (not Cascade) so an application's audit
  // trail can never vanish just because the linked Affiliate row
  // somehow did (it never actually does — Affiliate has no hard-delete
  // path — but the relation is declared defensively regardless).
  affiliateId String?    @unique
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  status AffiliateApplicationStatus @default(DRAFT)

  // ---- Personal details (brief section 6) --------------------------------
  // Deliberately separate from Customer.firstName/lastName — this is the
  // applicant's own confirmed LEGAL identity for verification purposes,
  // pre-filled from the account where safe but never silently assumed to
  // be identical, and never written back onto Customer itself (brief
  // section 7: "do not silently overwrite the customer's main account
  // identity").
  firstName      String?
  middleName     String?
  surname        String?
  dateOfBirth    DateTime?
  nationality    String?
  identityType   AffiliateIdentityDocumentType?
  // Only one of these two is ever populated, matching identityType —
  // enforced at the service layer (schema-level "exactly one of A/B"
  // constraints don't exist in Postgres/Prisma without a check
  // constraint this migration deliberately avoids adding). Never shown
  // unmasked in any list view — see affiliateApplication.service.ts's
  // maskIdentityNumber().
  idNumber       String?
  passportNumber String?

  // ---- Contact details (brief section 7) ---------------------------------
  contactEmail           String?
  mobileNumber           String?
  whatsappNumber         String?
  preferredContactMethod String?

  // ---- Residential details (brief section 8) ------------------------------
  addressLine1 String?
  addressLine2 String?
  suburb       String?
  city         String?
  province     String?
  postalCode   String?
  country      String?

  // ---- Applicant type (brief section 9) -----------------------------------
  applicantType              AffiliateApplicantType @default(INDIVIDUAL)
  businessName               String?
  businessRegistrationNumber String?
  businessWebsite            String?

  // ---- Affiliate / promotional information (brief section 10) ------------
  promotionPlan String?
  websiteUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  otherPlatform String?
  audienceSize  String?
  motivation    String?

  // ---- Declarations (brief section 31) ------------------------------------
  // Never pre-ticked; both must be explicitly true, at the moment of
  // submission, for status to reach SUBMITTED — see requireDeclarations()
  // in affiliateApplication.service.ts. termsVersion records which
  // version of /affiliate-terms was live at the moment of acceptance.
  infoAccurateConfirmedAt DateTime?
  termsAcceptedAt         DateTime?
  termsVersion            String?

  // ---- Review outcome (brief sections 28/36/39) ---------------------------
  actionRequiredReason String?
  actionRequiredArea   String?

  submittedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  documents AffiliateApplicationDocument[]
  events    AffiliateApplicationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One row per uploaded document *version* — a replacement (brief section
// 40) never overwrites a row in place; it creates a new one and marks
// the previous row isCurrent: false, so admin-visible history survives
// (brief section 41) without ever leaving two "current" documents in the
// same slot. storageBucket/storagePath are internal-only, exactly like
// DigitalAsset's own storageBucket/storagePath — never selected into any
// API response; a signed URL is generated fresh, on demand, by the owning
// customer or an authorised admin only (see
// affiliateDocumentStorage.service.ts).
model AffiliateApplicationDocument {
  id            String               @id @default(cuid())
  applicationId String
  application   AffiliateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  slot                 AffiliateDocumentSlot
  identityDocumentType AffiliateIdentityDocumentType?
  proofOfResidenceType AffiliateProofOfResidenceType?

  storageBucket String
  storagePath   String
  // Safe display metadata only — a short, sanitised fragment of the
  // original filename (never the full original name verbatim; see
  // buildAffiliateDocumentStoragePath() in affiliateDocument.service.ts),
  // never the storage path itself.
  fileName      String
  mimeType      String
  fileSizeBytes Int

  isCurrent Boolean @default(true)

  // ---- Automated verification results (brief sections 17/24-27) ----------
  // classification=null means "not yet classified" (should only ever be
  // momentary — classification runs synchronously right after upload);
  // MANUAL_REVIEW (never a silent guess) is the honest result whenever
  // text extraction was unavailable (e.g. a JPG/PNG photo — see
  // documentTextExtraction.service.ts's own header comment for why this
  // backend does not attempt OCR) or genuinely inconclusive.
  classification        AffiliateDocumentMatchResult?
  // Short, safe, human-readable summary only — e.g. "Bank name and
  // statement wording detected." NEVER raw extracted text, account
  // numbers, or balances (brief sections 43/44).
  classificationReason  String?
  nameMatchResult       AffiliateDocumentMatchResult?
  addressMatchResult    AffiliateDocumentMatchResult?
  idNumberMatchResult   AffiliateDocumentMatchResult?
  // Best-effort only, proof-of-residence documents only — brief section
  // 13 explicitly says not to invent a validity-period rule, so this is
  // captured for admin visibility alone; nothing in this codebase reads
  // it to reject anything.
  documentDateExtracted DateTime?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([applicationId, slot, isCurrent])
}

enum AffiliateDocumentSlot {
  IDENTITY
  PROOF_OF_RESIDENCE
}

// Append-only audit trail (brief section 41) — never updated or deleted,
// and never stores raw document content/extracted text/full identity
// numbers, only short safe summaries (same discipline as
// classificationReason above). actorAdminUserId is SetNull, not Cascade,
// matching OrderStatusHistory's own "audit history must outlive the
// admin who generated it" precedent.
model AffiliateApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  application   AffiliateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  eventType AffiliateApplicationEventType
  actorType AffiliateApplicationEventActor

  actorAdminUserId String?
  actorAdminUser   AdminUser? @relation(fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  summary String

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
}
